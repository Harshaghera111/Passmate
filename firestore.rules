rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Canonical whitelist of authorized demo phone numbers.
     *
     * CRITICAL SYNC & SECURITY REQUIREMENT:
     * Must remain 1:1 synchronized with DEMO_PHONES in authService.ts.
     * Stored in E.164 format matching the Firebase Auth cryptographically signed
     * token claim `request.auth.token.phone_number`.
     * Client-side environment variables alone CANNOT grant demo privileges in Firestore.
     */
    function isDemoCaller() {
      return isSignedIn() && (
        request.auth.token.phone_number in [
          '+917620981982',  // Primary demo test phone
          '+919845012345',  // Seed Student
          '+919845001234',  // Seed Warden
          '+919900012345',  // Seed Guard
          '+919000000001'   // Seed Admin
        ]
      );
    }

    /**
     * Helper to validate that a role string is one of the supported system roles.
     */
    function isValidRole(role) {
      return role in ['student', 'warden', 'guard', 'admin', 'parent'];
    }

    /**
     * Safely fetch the caller's role from their Firestore user document.
     * Returns 'unknown' when the document does not exist, preventing crashes
     * caused by missing user profiles (e.g. first-time OTP login).
     */
    function userRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.get('role', 'unknown');
    }

    function isRole(role) {
      return isSignedIn() && userRole() == role;
    }

    /**
     * Safely get the caller's hostelId.
     * Returns null when the document or field does not exist.
     */
    function callerHostel() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.get('hostel', null);
    }

    // ── /users/{uid} ──────────────────────────────────────────────────────────

    match /users/{uid} {
      // Own profile: always readable by the user themselves, or by warden/admin
      allow read:   if isSignedIn() && (
                      request.auth.uid == uid ||
                      userRole() == 'warden'  ||
                      userRole() == 'admin'
                    );

      // Creation security:
      // 1. Caller must be signed in as uid.
      // 2. Role must be a valid system role.
      // 3. Demo phone numbers can create any role (student, warden, guard, admin, parent) and set isDemo: true.
      // 4. Production users can only create student or parent accounts and cannot set isDemo: true.
      allow create: if isSignedIn() && request.auth.uid == uid
                    && isValidRole(request.resource.data.get('role', 'student'))
                    && (
                      isDemoCaller() || (
                        request.resource.data.get('role', 'student') in ['student', 'parent'] &&
                        request.resource.data.get('isDemo', false) == false
                      )
                    );

      // Update security:
      // 1. Caller must be signed in as uid.
      // 2. Demo phone numbers: role must be valid, and updates restricted to known user schema fields.
      // 3. Production users: CANNOT modify protected fields ('role', 'isDemo', 'roleProfiles').
      //    Ensures isDemo cannot be self-assigned or flipped by unauthorized accounts.
      allow update: if isSignedIn() && request.auth.uid == uid && (
                      (
                        isDemoCaller() &&
                        isValidRole(request.resource.data.get('role', 'student')) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'role', 'name', 'usn', 'room', 'hostel', 'profileComplete',
                          'roleProfiles', 'updatedAt', 'createdAt', 'isDemo', 'phone', 'uid',
                          'parentEmail'
                        ])
                      ) || (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isDemo', 'roleProfiles'])
                      )
                    );
      allow delete: if false;
    }

    // ── /passes/{passId} ─────────────────────────────────────────────────────

    match /passes/{passId} {

      // READ: own pass | warden/guard scoped to their hostel | admin
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid  ||   // student reads own
        (userRole() == 'warden' && resource.data.hostel == callerHostel()) ||
        (userRole() == 'guard'  && resource.data.hostel == callerHostel()) ||
        userRole() == 'admin'
      );

      // CREATE: students only, must match their own uid, must start as pending
      allow create: if isSignedIn()
        && userRole() == 'student'
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.hostel != null;    // hostelId is mandatory

      // UPDATE: role-scoped field restrictions
      allow update: if isSignedIn() && (

        // Warden approve/reject — hostel-scoped
        (userRole() == 'warden'
          && resource.data.hostel == callerHostel()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'wardenApproved', 'wardenApprovedAt', 'wardenId',
               'wardenNote', 'qrData', 'approvedAt', 'approvedBy'
             ])) ||

        // Guard mark exit / entry — hostel-scoped
        (userRole() == 'guard'
          && resource.data.hostel == callerHostel()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'exitTime', 'entryTime', 'actualReturn', 'isLate', 'status',
               'exitMarkedBy', 'entryMarkedBy'
             ])) ||

        // Parent approval
        (userRole() == 'parent'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'parentApproved', 'parentApprovedAt', 'status'
             ])) ||

        // Admin can update any field
        userRole() == 'admin'
      );

      // DELETE: never allowed — passes are permanent audit records
      allow delete: if false;
    }

    // ── /audit_logs/{logId} ───────────────────────────────────────────────────

    match /audit_logs/{logId} {
      // READ: warden (hostel-scoped) or admin
      allow read: if isSignedIn() && (
        userRole() == 'admin' ||
        (userRole() == 'warden' && resource.data.get('hostelId', null) == callerHostel())
      );

      // CREATE: any authenticated user, but actorId MUST equal the caller uid
      // This prevents one user from writing audit logs on behalf of another.
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid;

      // UPDATE / DELETE: never — audit logs are immutable
      allow update: if false;
      allow delete: if false;
    }
  }
}
