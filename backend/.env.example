# PassMate Backend Configuration Example
# Copy to .env and configure for your environment. Never commit production secrets.

PORT=3001
SUPABASE_DB_URL=postgresql://user:password@host:5432/database

# ── Firebase Admin SDK Configuration ──────────────────────────────────────────
# Required for server-side Firestore operations (e.g. secure parent magic-link approvals).
# Provide credentials via ONE of the options below:

# Option 1: Complete Service Account JSON as a single-line string
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"passmate-app-43c97",...}

# Option 2: Individual credential fields
FIREBASE_PROJECT_ID=passmate-app-43c97
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@passmate-app-43c97.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 3: Local file path to service account JSON (standard Google Cloud ADC)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
